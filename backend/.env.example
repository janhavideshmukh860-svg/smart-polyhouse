# ==========================================================
# SMART POLYHOUSE BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# ---- Application ----
APP_NAME="Smart Polyhouse Backend"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Database (PostgreSQL / Supabase-compatible) ----
# Standard PostgreSQL connection string.
# For Supabase: use the "Connection string" from Project Settings > Database
# (use the pooled "Transaction" connection string for serverless, or the
# direct connection string for long-lived backend processes).
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/smart_polyhouse

# Set to "true" to allow the app to boot even if the DB is unreachable
# (useful for local ML experimentation without a database).
ALLOW_START_WITHOUT_DB=true

# ---- JWT Auth ----
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed origins, e.g. for the Lovable frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Dataset / Model Paths (relative to project root, override if needed) ----
DATASET_ROOT=./dataset/06_final_dataset
DISEASE_DATASET_ROOT=./dataset/06_final_dataset/disease
IRRIGATION_DATASET_ROOT=./dataset/06_final_dataset/irrigation
MODEL_ARTIFACT_ROOT=./ml_models

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Disease Model Training (defaults, overridable per run) ----
DISEASE_IMAGE_SIZE=224
DISEASE_BATCH_SIZE=32
DISEASE_EPOCHS=15
DISEASE_LEARNING_RATE=0.0003
DISEASE_NUM_WORKERS=2

# ---- Irrigation Decision Engine thresholds (Part 2) ----
# Percent Volumetric_Moisture_Pct unless noted. See
# app/services/decision_engine.py for how these are used.
IRRIGATION_CRITICAL_MOISTURE_PCT=12.0
IRRIGATION_LOW_MOISTURE_PCT=18.0
IRRIGATION_MONITOR_MOISTURE_PCT=24.0
IRRIGATION_DECLINE_RATE_WARNING_PCT=4.0
IRRIGATION_DECLINE_RATE_CRITICAL_PCT=8.0

# ---- Sensor data freshness (Part 2 dashboard/alerts) ----
SENSOR_STALE_AFTER_MINUTES=120
